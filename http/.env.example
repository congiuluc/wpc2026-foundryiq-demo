# Copiare in http\.env, escluso da Git. Non aggiungere Bearer ai token.
# Endpoint senza slash finale; usare nomi KB compatibili con un segmento URL.
FOUNDRYIQ_DEMO_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
FOUNDRYIQ_DEMO_KB_NAME=wpc-foundryiq-kb
FOUNDRYIQ_ACL_KB_NAME=wpc-acl-kb
FOUNDRYIQ_DEMO_PROJECT_ENDPOINT=https://YOUR-FOUNDRY.services.ai.azure.com/api/projects/YOUR-PROJECT
SEARCH_TOKEN=
USER_SEARCH_TOKEN=
FOUNDRY_TOKEN=
