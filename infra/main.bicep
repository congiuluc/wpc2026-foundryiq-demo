targetScope = 'subscription'

// Orchestrator used by `azd provision`: every resource lives in a module under ./modules.

@description('Name of the azd environment; used for the resource group name and tags.')
@minLength(1)
@maxLength(64)
param environmentName string

@description('Region that supports Foundry IQ and all model deployments.')
param location string

@description('Existing or new resource group name. Default: rg-<environmentName>.')
param resourceGroupName string = ''

@description('Object ID of the interactive demo user (azd sets AZURE_PRINCIPAL_ID to the signed-in identity).')
@minLength(36)
@maxLength(36)
param demoUserObjectId string

@allowed([
  'User'
  'ServicePrincipal'
])
param demoUserPrincipalType string = 'User'

@description('Login shown as Microsoft Entra administrator of the SQL server (UPN of the deployer).')
param sqlAdminLogin string

@description('Name of the project created inside the Foundry account.')
@minLength(2)
@maxLength(64)
param foundryProjectName string = 'wpc-foundry-iq-demo'

@description('Azure OpenAI chat model supported by Foundry IQ.')
param chatModel string = 'gpt-5-mini'

@description('Version of the chat model available in the target region.')
param chatModelVersion string = '2025-08-07'

@description('SKU for the chat model deployment.')
param chatDeploymentSku string = 'DataZoneStandard'

@description('Capacity units for the chat model deployment.')
@minValue(1)
param chatCapacity int = 200

@description('Capacity units for the embedding deployment.')
@minValue(1)
param embeddingCapacity int = 20

@description('Capacity units for the GPT-5.2 Global Standard deployment.')
@minValue(1)
param gpt52Capacity int = 200

@description('App Service plan SKU for the MCP server (B1 = cheapest with Always On, F1 = free).')
param appServiceSkuName string = 'B1'

@description('Region of the Azure SQL server; override if the main region does not accept new SQL servers.')
param sqlLocation string = ''

@description('Use the Azure SQL Database free offer.')
param sqlUseFreeLimit bool = true

@description('Reach Azure SQL only through a private endpoint (VNet + App Service VNet integration). Needed when a policy disables SQL public access; the MCP server then loads the catalog itself.')
param sqlPrivateEndpoint bool = true

@secure()
@description('API key required by the MCP server in the x-api-key header (generated by the preprovision hook).')
param mcpApiKey string

@description('Client ID of the chat web app sign-in registration, saved by scripts/setup_chat_auth.ps1. Empty on the first provision: the app answers 401 until it is set.')
param chatAuthClientId string = ''

var tags = {
  workload: 'wpc-foundry-iq-demo'
  environment: 'demo'
  'azd-env-name': environmentName
}

resource rg 'Microsoft.Resources/resourceGroups@2024-03-01' = {
  name: empty(resourceGroupName) ? 'rg-${environmentName}' : resourceGroupName
  location: location
  tags: tags
}

// Same suffix as the former resource-group-scoped template, so existing environments keep their names.
var resourceToken = uniqueString(subscription().id, rg.id)

module monitoring 'modules/monitoring.bicep' = {
  scope: rg
  name: 'monitoring'
  params: {
    location: location
    resourceToken: resourceToken
    tags: tags
  }
}

module search 'modules/search.bicep' = {
  scope: rg
  name: 'search'
  params: {
    location: location
    resourceToken: resourceToken
    tags: tags
  }
}

module storage 'modules/storage.bicep' = {
  scope: rg
  name: 'storage'
  params: {
    location: location
    resourceToken: resourceToken
    tags: tags
  }
}

module storageAcl 'modules/storage-acl.bicep' = {
  scope: rg
  name: 'storage-acl'
  params: {
    location: location
    resourceToken: resourceToken
    tags: tags
  }
}

module foundry 'modules/foundry.bicep' = {
  scope: rg
  name: 'foundry'
  params: {
    location: location
    resourceToken: resourceToken
    projectName: foundryProjectName
    chatModel: chatModel
    chatModelVersion: chatModelVersion
    chatDeploymentSku: chatDeploymentSku
    chatCapacity: chatCapacity
    embeddingCapacity: embeddingCapacity
    gpt52Capacity: gpt52Capacity
    searchServiceName: search.outputs.name
    applicationInsightsName: monitoring.outputs.applicationInsightsName
    tags: tags
  }
}

module roles 'modules/role-assignments.bicep' = {
  scope: rg
  name: 'role-assignments'
  params: {
    demoUserObjectId: demoUserObjectId
    demoUserPrincipalType: demoUserPrincipalType
    searchServiceName: search.outputs.name
    storageAccountName: storage.outputs.name
    containerName: storage.outputs.containerName
    aclStorageAccountName: storageAcl.outputs.name
    foundryAccountName: foundry.outputs.accountName
    foundryProjectName: foundry.outputs.projectName
    applicationInsightsName: monitoring.outputs.applicationInsightsName
  }
}

module mcpIdentity 'modules/mcp-identity.bicep' = if (sqlPrivateEndpoint) {
  scope: rg
  name: 'mcp-identity'
  params: {
    location: location
    resourceToken: resourceToken
    tags: tags
  }
}

module sql 'modules/sql.bicep' = {
  scope: rg
  name: 'sql'
  params: {
    location: empty(sqlLocation) ? location : sqlLocation
    resourceToken: resourceToken
    // Private mode: the MCP server identity is the Entra admin, because nobody can connect from outside the VNet.
    adminLogin: sqlPrivateEndpoint ? mcpIdentity!.outputs.name : sqlAdminLogin
    adminObjectId: sqlPrivateEndpoint ? mcpIdentity!.outputs.principalId : demoUserObjectId
    adminPrincipalType: sqlPrivateEndpoint || demoUserPrincipalType == 'ServicePrincipal' ? 'Application' : 'User'
    useFreeLimit: sqlUseFreeLimit
    privateOnly: sqlPrivateEndpoint
    tags: tags
  }
}

module network 'modules/network.bicep' = if (sqlPrivateEndpoint) {
  scope: rg
  name: 'network'
  params: {
    location: location
    resourceToken: resourceToken
    sqlServerId: sql.outputs.serverId
    tags: tags
  }
}

module mcpApp 'modules/appservice.bicep' = {
  scope: rg
  name: 'mcp-appservice'
  params: {
    location: location
    resourceToken: resourceToken
    skuName: appServiceSkuName
    sqlServerFqdn: sql.outputs.serverFqdn
    sqlDatabaseName: sql.outputs.databaseName
    mcpApiKey: mcpApiKey
    sqlIdentityId: sqlPrivateEndpoint ? mcpIdentity!.outputs.id : ''
    sqlIdentityClientId: sqlPrivateEndpoint ? mcpIdentity!.outputs.clientId : ''
    vnetSubnetId: sqlPrivateEndpoint ? network!.outputs.appServiceSubnetId : ''
    tags: tags
  }
}

module chatApp 'modules/webapp-chat.bicep' = {
  scope: rg
  name: 'webapp-chat'
  params: {
    location: location
    resourceToken: resourceToken
    planId: mcpApp.outputs.planId
    alwaysOn: appServiceSkuName != 'F1'
    searchEndpoint: search.outputs.endpoint
    openAIEndpoint: foundry.outputs.openAIEndpoint
    chatDeploymentName: foundry.outputs.chatDeploymentName
    projectEndpoint: foundry.outputs.projectEndpoint
    authClientId: chatAuthClientId
    tags: tags
  }
}

module chatRoles 'modules/webapp-chat-roles.bicep' = {
  scope: rg
  name: 'webapp-chat-roles'
  params: {
    principalId: chatApp.outputs.principalId
    searchServiceName: search.outputs.name
    foundryAccountName: foundry.outputs.accountName
  }
}

var demoConfig = {
  FOUNDRYIQ_DEMO_TENANT_ID: tenant().tenantId
  FOUNDRYIQ_DEMO_SEARCH_ENDPOINT: search.outputs.endpoint
  FOUNDRYIQ_DEMO_BLOB_ENDPOINT: storage.outputs.blobEndpoint
  FOUNDRYIQ_DEMO_STORAGE_RESOURCE_ID: storage.outputs.id
  FOUNDRYIQ_DEMO_BLOB_CONTAINER: storage.outputs.containerName
  FOUNDRYIQ_DEMO_OPENAI_ENDPOINT: foundry.outputs.openAIEndpoint
  FOUNDRYIQ_DEMO_CHAT_DEPLOYMENT: foundry.outputs.chatDeploymentName
  FOUNDRYIQ_DEMO_EMBEDDING_DEPLOYMENT: foundry.outputs.embeddingDeploymentName
  FOUNDRYIQ_DEMO_GPT52_DEPLOYMENT: foundry.outputs.gpt52DeploymentName
  FOUNDRYIQ_DEMO_PROJECT_ENDPOINT: foundry.outputs.projectEndpoint
}

// Stable deployment name read by new-agent-deployment.ipynb (BICEP_DEPLOYMENT_NAME).
module demoOutputs 'modules/demo-config.bicep' = {
  scope: rg
  name: 'wpc-foundry-iq-demo'
  params: {
    demoConfig: demoConfig
    foundryAccountName: foundry.outputs.accountName
    foundryProjectName: foundry.outputs.projectName
    foundryProjectId: foundry.outputs.projectId
    foundryProjectEndpoint: foundry.outputs.projectEndpoint
    storageAccountName: storage.outputs.name
    applicationInsightsName: monitoring.outputs.applicationInsightsName
    applicationInsightsResourceId: monitoring.outputs.applicationInsightsId
    logAnalyticsWorkspaceResourceId: monitoring.outputs.logAnalyticsWorkspaceId
  }
}

// Outputs are saved by azd in .azure/<env>/.env and read by the hooks.
output AZURE_LOCATION string = location
output AZURE_TENANT_ID string = tenant().tenantId
output AZURE_RESOURCE_GROUP string = rg.name

output FOUNDRYIQ_DEMO_TENANT_ID string = tenant().tenantId
output FOUNDRYIQ_DEMO_SEARCH_ENDPOINT string = search.outputs.endpoint
output FOUNDRYIQ_DEMO_BLOB_ENDPOINT string = storage.outputs.blobEndpoint
output FOUNDRYIQ_DEMO_STORAGE_RESOURCE_ID string = storage.outputs.id
output FOUNDRYIQ_DEMO_BLOB_CONTAINER string = storage.outputs.containerName
output FOUNDRYIQ_DEMO_OPENAI_ENDPOINT string = foundry.outputs.openAIEndpoint
output FOUNDRYIQ_DEMO_CHAT_DEPLOYMENT string = foundry.outputs.chatDeploymentName
output FOUNDRYIQ_DEMO_CHAT_MODEL string = foundry.outputs.chatModelName
output FOUNDRYIQ_DEMO_EMBEDDING_DEPLOYMENT string = foundry.outputs.embeddingDeploymentName
output FOUNDRYIQ_DEMO_GPT52_DEPLOYMENT string = foundry.outputs.gpt52DeploymentName
output FOUNDRYIQ_DEMO_PROJECT_ENDPOINT string = foundry.outputs.projectEndpoint
output FOUNDRYIQ_SEARCH_CONNECTION_ID string = foundry.outputs.searchConnectionId

output FOUNDRYIQ_ACL_STORAGE_ACCOUNT string = storageAcl.outputs.name
output FOUNDRYIQ_ACL_STORAGE_RESOURCE_ID string = storageAcl.outputs.id
output FOUNDRYIQ_ACL_DFS_ENDPOINT string = storageAcl.outputs.dfsEndpoint
output FOUNDRYIQ_ACL_CONTAINER string = storageAcl.outputs.containerName

output SEARCH_SERVICE_NAME string = search.outputs.name
output SEARCH_PRINCIPAL_ID string = search.outputs.principalId
output STORAGE_ACCOUNT_NAME string = storage.outputs.name
output FOUNDRY_ACCOUNT_NAME string = foundry.outputs.accountName
output FOUNDRY_PROJECT_NAME string = foundry.outputs.projectName
output FOUNDRY_PROJECT_ID string = foundry.outputs.projectId
output APPLICATION_INSIGHTS_NAME string = monitoring.outputs.applicationInsightsName

output SQL_SERVER_NAME string = sql.outputs.serverName
output SQL_SERVER_FQDN string = sql.outputs.serverFqdn
output SQL_DATABASE_NAME string = sql.outputs.databaseName
output SQL_PRIVATE_ENDPOINT bool = sqlPrivateEndpoint

output MCP_APP_NAME string = mcpApp.outputs.name
output MCP_APP_PRINCIPAL_ID string = mcpApp.outputs.principalId
output MCP_SERVER_URL string = '${mcpApp.outputs.uri}/mcp'
output MCP_HEALTH_URL string = '${mcpApp.outputs.uri}/healthz'

output CHAT_APP_NAME string = chatApp.outputs.name
output CHAT_APP_URL string = chatApp.outputs.uri
output CHAT_APP_AUTH_IDENTITY_PRINCIPAL_ID string = chatApp.outputs.authIdentityPrincipalId
output DEMO_DEPLOYMENT_NAME string = demoOutputs.name
