{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION=swedencentral}"
    },
    "resourceGroupName": {
      "value": "${AZURE_RESOURCE_GROUP}"
    },
    "demoUserObjectId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "demoUserPrincipalType": {
      "value": "${AZURE_PRINCIPAL_TYPE=User}"
    },
    "sqlAdminLogin": {
      "value": "${AZURE_PRINCIPAL_NAME}"
    },
    "chatCapacity": {
      "value": "${CHAT_CAPACITY=100}"
    },
    "embeddingCapacity": {
      "value": "${EMBEDDING_CAPACITY=10}"
    },
    "gpt52Capacity": {
      "value": "${GPT52_CAPACITY=100}"
    },
    "appServiceSkuName": {
      "value": "${APP_SERVICE_SKU=B1}"
    },
    "sqlLocation": {
      "value": "${SQL_LOCATION}"
    },
    "sqlUseFreeLimit": {
      "value": "${SQL_USE_FREE_LIMIT=true}"
    },
    "sqlPrivateEndpoint": {
      "value": "${SQL_PRIVATE_ENDPOINT=true}"
    },
    "mcpApiKey": {
      "value": "${MCP_API_KEY}"
    },
    "chatAuthClientId": {
      "value": "${CHAT_APP_CLIENT_ID}"
    }
  }
}
